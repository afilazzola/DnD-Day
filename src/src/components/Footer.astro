---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dnd-bg-secondary border-t border-dnd-border mt-auto">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div>
        <div class="mb-4">
          <img src="/images/logo.png" alt="DnD Day" class="h-[84px] w-auto" />
        </div>
        <p class="text-dnd-text-muted text-sm leading-relaxed">
          Operation Golden Sword — A massive multi-table DnD event where heroes
          unite to break the Iron Conclave's grip on Amn.
        </p>
      </div>

      <!-- The Story -->
      <div>
        <h4 class="font-display text-dnd-primary text-sm uppercase tracking-wider mb-4">
          The Story
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="/story" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              Campaign Overview
            </a>
          </li>
          <li>
            <a href="/enemies" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              The Enemies
            </a>
          </li>
          <li>
            <a href="/briefing" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              Mission Briefing
            </a>
          </li>
          <li>
            <a href="/theaters" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              Theaters of War
            </a>
          </li>
        </ul>
      </div>

      <!-- The Event -->
      <div>
        <h4 class="font-display text-dnd-primary text-sm uppercase tracking-wider mb-4">
          The Event
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="/event" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              Event Details
            </a>
          </li>
          <li>
            <a href="/players" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              For Players
            </a>
          </li>
          <li>
            <a href="/dm-prep" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              For DMs
            </a>
          </li>
          <li>
            <a href="/signup" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              Sign Up
            </a>
          </li>
          <li>
            <a href="/contact" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              Contact
            </a>
          </li>
          <li>
            <a href="/gallery" class="text-dnd-text-muted hover:text-dnd-text text-sm transition-colors">
              Gallery
            </a>
          </li>
        </ul>
      </div>

      <!-- Event Info -->
      <div>
        <h4 class="font-display text-dnd-primary text-sm uppercase tracking-wider mb-4">
          Event Info
        </h4>
        <ul class="space-y-2 text-sm text-dnd-text-muted">
          <li>📅 June 6, 2026 at 5:00 PM</li>
          <li>📍 Royal Canadian Legion, Coronation Branch 286</li>
          <li>📍 Etobicoke, Toronto, ON</li>
          <li>⏰ Duration: ~4-5 hours</li>
          <li>
            <a href="mailto:info@legendarydnd.ca" class="hover:text-dnd-text transition-colors">
              ✉️ info@legendarydnd.ca
            </a>
          </li>
          <li>
            <a href="https://discord.gg/mV4ZThMVsb" target="_blank" rel="noopener noreferrer nofollow" class="hover:text-dnd-text transition-colors">
              💬 Join our Discord
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-dnd-border mt-8 pt-8 text-center">
      <p class="text-dnd-text-muted text-sm">
        &copy; {currentYear} DnD Day — Operation Golden Sword. Roll for initiative.
      </p>
    </div>
  </div>
</footer>
