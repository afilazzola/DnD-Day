---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Custom Terrain & Miniatures"
  description="Handcrafted battlefields for every theater of war — beaches, forests, cathedral chambers, and skies. See the custom terrain built for DnD Day Operation Golden Sword."
>
  <!-- Header -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom text-center">
      <p class="section-title">The Event</p>
      <h1 class="text-4xl md:text-5xl font-display mb-4">
        <span class="gold-gradient">Custom Terrain</span>
      </h1>
      <p class="text-dnd-text-muted text-lg max-w-2xl mx-auto">
        Bringing Operation Golden Sword to life with handcrafted battlefields and detailed miniatures.
      </p>
    </div>
  </section>

  <!-- Immersion Section -->
  <section class="py-16">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <p class="section-title">Experience</p>
          <h2 class="text-2xl md:text-3xl font-display">
            <span class="gold-gradient">Immersive Battlefields</span>
          </h2>
        </div>

        <div class="card">
          <p class="text-dnd-text-muted leading-relaxed mb-6">
            Custom terrain transforms tabletop gaming from imagination alone into a tangible,
            shared experience. When you can see the sandy beaches your characters are storming,
            the dense forests hiding enemy forces, or the soaring spire of Sainte-Mère-Église Cathedral,
            every tactical decision becomes more meaningful and every heroic moment more memorable.
          </p>
          <p class="text-dnd-text-muted leading-relaxed">
            For Operation Golden Sword, we're building custom terrain pieces for each theater of war,
            ensuring that whether you're landing on the beaches, navigating forest paths, breaching
            dungeon corridors, or battling in the skies, you'll have a battlefield worthy of your adventure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Terrain Gallery -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom">
      <div class="text-center mb-10">
        <p class="section-title">Gallery</p>
        <h2 class="text-2xl md:text-3xl font-display">
          <span class="gold-gradient">Terrain Preview</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Tavern at Night -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/tavern-at-night.jpg"
            data-alt="Adventurers gathered at a Velen tavern on the eve of invasion"
          >
            <img
              src="/images/tavern-at-night.jpg"
              alt="Adventurers gathered at a Velen tavern on the eve of invasion"
              class="w-full h-[28rem] object-cover hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">The Last Night in Velen</h3>
            <p class="text-dnd-text-muted text-sm">
              Adventurers share a final drink before the invasion. The tavern buzzes with nervous energy,
              whispered plans, and farewells that may be the last. By dawn, the fleet sets sail.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Walking through the Forest -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/walking-through-the-forest.jpg"
            data-alt="Adventurers pushing inland through the forest toward Sainte-Mère-Église Cathedral"
          >
            <img
              src="/images/walking-through-the-forest.jpg"
              alt="Adventurers pushing inland through the forest toward Sainte-Mère-Église Cathedral"
              class="w-full h-[28rem] object-cover hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">The Road Inland</h3>
            <p class="text-dnd-text-muted text-sm">
              With the bridge secured, the heroes press through dense woodland toward the Cathedral.
              The forest road is quiet — but the Iron Conclave does not leave roads unguarded for long.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Orcs on the Prowl -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/orcs-on-the-prowl.jpg"
            data-alt="Iron Conclave orc sentinels patrolling fortified positions"
          >
            <img
              src="/images/orcs-on-the-prowl.jpg"
              alt="Iron Conclave orc sentinels patrolling fortified positions"
              class="w-full h-[28rem] object-cover hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">Iron Conclave Fortifications</h3>
            <p class="text-dnd-text-muted text-sm">
              Orc war-clan sentinels hold the line behind fortified stone and iron bars. Every
              approach to the bridge — and beyond — is watched, patrolled, and ready to bleed the invaders dry.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Through the Church Remains -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/through-the-church-remains.jpg"
            data-alt="Adventurers arriving at the ruined walls of Sainte-Mère-Église Cathedral"
          >
            <img
              src="/images/through-the-church-remains.jpg"
              alt="Adventurers arriving at the ruined walls of Sainte-Mère-Église Cathedral"
              class="w-full h-[28rem] object-cover hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">Sainte-Mère-Église Cathedral</h3>
            <p class="text-dnd-text-muted text-sm">
              The Cathedral was promised to be a fortress. What the heroes find are shattered walls still
              held by fanatics — a ruin defiant to the last, its stones soaked in years of war.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Catapult & Battlefield -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/Catapult_Background.jpg"
            data-alt="Catapult siege engine on the battlefield"
          >
            <img
              src="/images/Catapult_Background.jpg"
              alt="Catapult siege engine on the battlefield"
              class="w-full h-[28rem] object-contain hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">Siege Train</h3>
            <p class="text-dnd-text-muted text-sm">
              Catapults and ballistas ready for the assault on Sainte-Mère-Église Cathedral.
              Built for the Stone Breakers' grueling push from Gold Beach through Hoc's Point.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Bastilla -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/Ballista.jpg"
            data-alt="Bastilla war engine on the battlefield"
          >
            <img
              src="/images/Ballista.jpg"
              alt="Bastilla war engine on the battlefield"
              class="w-full h-[28rem] object-contain hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">Bastilla</h3>
            <p class="text-dnd-text-muted text-sm">
              A formidable bastilla siege engine, ready to breach enemy fortifications.
              A key asset for the Stone Breakers pushing toward Sainte-Mère-Église Cathedral.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Forest & Airship -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/terrain-forest-airship.jpg"
            data-alt="Forest terrain with airship miniature"
          >
            <img
              src="/images/terrain-forest-airship.jpg"
              alt="Forest terrain with airship miniature"
              class="w-full h-[28rem] object-cover hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">Forest & Sky</h3>
            <p class="text-dnd-text-muted text-sm">
              Dense woodland terrain with towering trees and an airship ready for aerial combat
              scenarios. Perfect for ambushes and the Storm Riders' sky battles.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Beach & Ship -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/terrain-beach-ship.jpg"
            data-alt="Beach terrain with naval vessel"
          >
            <img
              src="/images/terrain-beach-ship.jpg"
              alt="Beach terrain with naval vessel"
              class="w-full h-[28rem] object-cover hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">Juno & Gold Beaches</h3>
            <p class="text-dnd-text-muted text-sm">
              Coastal assault terrain featuring sandy beaches, defensive fortifications,
              and naval vessels. Built for the dramatic beach landings.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Cathedral 1 -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/cathedral-1.jpg"
            data-alt="Sainte-Mère-Église Cathedral interior — pews, altar, and painted murals"
          >
            <img
              src="/images/cathedral-1.jpg"
              alt="Sainte-Mère-Église Cathedral interior — pews, altar, and painted murals"
              class="w-full h-[28rem] object-cover object-top hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">The Cathedral — Overview</h3>
            <p class="text-dnd-text-muted text-sm">
              The final arena. Sainte-Mère-Église Cathedral — where all four theaters converge
              to face the warmagus. Rows of pews line the checkered nave, flanked by dramatic
              battle murals, with the altar waiting at the far end.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>

        <!-- Cathedral 2 -->
        <div class="card overflow-hidden p-0">
          <button
            class="w-full cursor-pointer lightbox-trigger"
            data-src="/images/cathedral-2.jpg"
            data-alt="Sainte-Mère-Église Cathedral interior — stained glass window and altar with cultists"
          >
            <img
              src="/images/cathedral-2.jpg"
              alt="Sainte-Mère-Église Cathedral interior — stained glass window and altar with cultists"
              class="w-full h-[28rem] object-cover object-top hover:scale-105 transition-transform duration-300"
            />
          </button>
          <div class="p-6">
            <h3 class="font-display text-dnd-primary text-xl mb-2">The Cathedral — The Altar</h3>
            <p class="text-dnd-text-muted text-sm">
              The warmagus holds court at the altar, illuminated by a towering stained glass window.
              The cultists are already in position. The heroes will have to fight through every pew
              to reach him.
            </p>
            <p class="text-dnd-text-muted/60 text-xs mt-3">Click image to view full size</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Materials List -->
  <section class="py-16">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <p class="section-title">Materials</p>
          <h2 class="text-2xl md:text-3xl font-display">
            <span class="gold-gradient">What We're Providing</span>
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="card text-center">
            <span class="text-4xl mb-4 block">🏖️</span>
            <h3 class="font-display text-dnd-primary mb-2">Beach Terrain</h3>
            <p class="text-dnd-text-muted text-sm">
              Sandy shores, rocky outcrops, and coastal fortifications for the amphibious assault.
            </p>
          </div>

          <div class="card text-center">
            <span class="text-4xl mb-4 block">🌲</span>
            <h3 class="font-display text-dnd-primary mb-2">Forest Terrain</h3>
            <p class="text-dnd-text-muted text-sm">
              Dense woodland with trees, undergrowth, and hidden paths for tactical maneuvering.
            </p>
          </div>

          <div class="card text-center">
            <span class="text-4xl mb-4 block">🏰</span>
            <h3 class="font-display text-dnd-primary mb-2">Dungeon Terrain</h3>
            <p class="text-dnd-text-muted text-sm">
              Stone corridors, soaring nave, and the Cathedral's interior chambers.
            </p>
          </div>

          <div class="card text-center">
            <span class="text-4xl mb-4 block">⛵</span>
            <h3 class="font-display text-dnd-primary mb-2">Boats & Ships</h3>
            <p class="text-dnd-text-muted text-sm">
              Landing craft, transport vessels, and naval ships for the beach invasion.
            </p>
          </div>

          <div class="card text-center">
            <span class="text-4xl mb-4 block">🎈</span>
            <h3 class="font-display text-dnd-primary mb-2">Airships</h3>
            <p class="text-dnd-text-muted text-sm">
              Flying vessels and platforms for the Storm Riders' aerial combat theater.
            </p>
          </div>

          <div class="card text-center">
            <span class="text-4xl mb-4 block">🌀</span>
            <h3 class="font-display text-dnd-primary mb-2">Portals</h3>
            <p class="text-dnd-text-muted text-sm">
              Arcane gateways and teleportation circles for Bête noire's infiltration.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Miniatures Section -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <p class="section-title">Miniatures</p>
          <h2 class="text-2xl md:text-3xl font-display">
            <span class="gold-gradient">Bring Your Character to Life</span>
          </h2>
        </div>

        <div class="card bg-dnd-primary/10 border-dnd-primary">
          <div class="flex items-start gap-4">
            <span class="text-4xl">🎭</span>
            <div>
              <h3 class="font-display text-dnd-primary mb-3">Your Miniature</h3>
              <p class="text-dnd-text-muted leading-relaxed mb-4">
                We encourage all players to bring a miniature representing their character.
                Having your own figure on the battlefield adds a personal connection to every
                encounter and makes those heroic moments truly yours.
              </p>
              <p class="text-dnd-text-muted leading-relaxed">
                <strong class="text-dnd-text">Don't have a miniature?</strong> No problem!
                Let us know and we can help provide one for you. We have a collection of
                miniatures available and can work with you to find something that fits your
                character's race, class, and style.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="container-custom text-center">
      <h2 class="text-2xl md:text-3xl font-display mb-4">
        <span class="gold-gradient">Ready to Storm the Beach?</span>
      </h2>
      <p class="text-dnd-text-muted mb-8 max-w-xl mx-auto">
        Sign up now to secure your spot in Operation Golden Sword.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/signup" class="btn btn-primary">Sign Up Now</a>
        <a href="/contact" class="btn btn-secondary">Questions? Contact Us</a>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm p-4"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 text-white hover:text-dnd-primary transition-colors p-2"
      aria-label="Close lightbox"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img
      id="lightbox-image"
      src=""
      alt=""
      class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl"
    />
  </div>

  <script>
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');
    const triggers = document.querySelectorAll('.lightbox-trigger');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-src');
        const alt = trigger.getAttribute('data-alt');
        if (src && lightboxImage && lightbox) {
          lightboxImage.src = src;
          lightboxImage.alt = alt || '';
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLightbox();
      }
    });
  </script>
</BaseLayout>
