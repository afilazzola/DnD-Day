---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<BaseLayout
  title="Registration Closed — Operation Golden Sword"
  description="Operation Golden Sword has concluded. Sign up to our mailing list to hear about future events."
>
  <!-- Header -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom text-center">
      <p class="section-title">Thank You</p>
      <h1 class="text-4xl md:text-5xl font-display mb-4">
        <span class="gold-gradient">Registration Closed</span>
      </h1>
      <p class="text-dnd-text-muted text-lg max-w-2xl mx-auto">
        Operation Golden Sword has concluded. Thank you to every hero who answered the call.
      </p>
    </div>
  </section>

  <!-- Thank You Section -->
  <section class="py-16">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <!-- Flyer Image -->
          <div class="order-2 md:order-1">
            <img
              src="/images/Flyer1_Iwantyou.jpg"
              alt="Operation Golden Sword - Recruitment Poster"
              class="rounded-lg shadow-2xl border-2 border-dnd-border w-full"
            />
          </div>

          <!-- Thank You Card -->
          <div class="order-1 md:order-2">
            <div class="card">
              <h2 class="text-2xl font-display text-dnd-primary mb-6">
                The Battle is Won
              </h2>
              <div class="prose prose-invert text-dnd-text-muted space-y-4">
                <p>
                  <span class="text-dnd-text font-semibold">Operation Golden Sword is complete.</span>
                </p>
                <p>
                  To every player, dungeon master, and spectator who joined us on the Sword Coast —
                  thank you. You brought Amn to life at the table and made this event truly legendary.
                </p>
                <p>
                  Registration for this event is now closed. But the campaign doesn't end here.
                </p>
                <p class="text-dnd-primary italic">
                  The next adventure awaits. Stay connected.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom">
      <div class="max-w-lg mx-auto">
        <NewsletterSignup
          title="Join the list for the next event"
          description="Be the first to hear when we announce our next campaign."
        />
      </div>
    </div>
  </section>

</BaseLayout>
