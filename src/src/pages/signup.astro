---
import BaseLayout from "../layouts/BaseLayout.astro";
const PLAYER_PAYMENT_LINK = "https://buy.stripe.com/6oUaEWazeghxfKl0sq2VG00";
const SPECTATOR_PAYMENT_LINK = "https://buy.stripe.com/3cIdR89va7L1fKla302VG01";
const GOOGLE_FORM_URL = "https://forms.gle/YatYTQdfLjxWqPnH7";
---

<BaseLayout
  title="Sign Up for Operation Golden Sword"
  description="Register for DnD Day on June 6, 2026. Choose your theater of war and join the multi-table D&D campaign to liberate Amn."
>
  <!-- Header -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom text-center">
      <p class="section-title">Join the Fight</p>
      <h1 class="text-4xl md:text-5xl font-display mb-4">
        <span class="gold-gradient">Enlist Now</span>
      </h1>
    </div>
  </section>

  <!-- Recruitment Call -->
  <section class="py-16">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <!-- Flyer Image -->
          <div class="order-2 md:order-1">
            <img
              src="/images/Flyer1_Iwantyou.jpg"
              alt="I Want You to Enlist Now - Recruitment Poster"
              class="rounded-lg shadow-2xl border-2 border-dnd-border w-full"
            />
          </div>

          <!-- Recruitment Text -->
          <div class="order-1 md:order-2">
            <div class="card">
              <h2 class="text-2xl font-display text-dnd-primary mb-6">
                A Call to Arms
              </h2>
              <div class="prose prose-invert text-dnd-text-muted space-y-4">
                <p>
                  <span class="text-dnd-text font-semibold">Hear me, brave souls of the realm!</span>
                </p>
                <p>
                  The enemy masses upon our shores. High Forgemaster Tharûm Blackmantle and his
                  wretched alliance have fortified Sainte-Mère-Église Cathedral, and every day their grip
                  on Amn tightens. Our people suffer. Our lands burn.
                </p>
                <p>
                  But we shall not yield.
                </p>
                <p>
                  Operation Golden Sword marshals the greatest fighting force this realm has
                  ever seen. We need warriors of all stripes—battle-hardened veterans and
                  fresh-faced recruits alike. Whether you wield sword, spell, or siege engine,
                  there is a place for you in our ranks.
                </p>
                <p>
                  <span class="text-dnd-text font-semibold">Four theaters of war await.</span>
                  Four chances to turn the tide. The assault begins soon, and glory favors
                  the bold.
                </p>
                <p class="text-dnd-primary italic">
                  Will you answer the call?
                </p>
              </div>

              <!-- CTA -->
              <div class="mt-8">
                <p class="text-dnd-text-muted text-sm text-center">
                  Choose your role below and secure your spot in the fight.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ticket Options -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom">
      <div class="text-center mb-10">
        <p class="section-title">Choose Your Role</p>
        <h2 class="text-2xl md:text-3xl font-display">
          <span class="gold-gradient">Secure Your Spot</span>
        </h2>
        <p class="text-dnd-text-muted mt-3 max-w-xl mx-auto">
          Limited seats. Every ticket includes exclusive take-home rewards — all you need to bring is your courage.
          <a href="/support" class="text-dnd-primary hover:underline transition-colors">Learn how fees support the event.</a>
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <!-- Player Ticket -->
        <div class="card border-2 border-dnd-primary flex flex-col">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-widest text-dnd-primary">Player</span>
            <span class="bg-dnd-primary/20 text-dnd-primary text-xs font-bold px-2 py-1 rounded">Limited Spots</span>
          </div>
          <div class="mb-6">
            <span class="text-5xl font-display text-dnd-text">$20</span>
            <span class="text-dnd-text-muted text-sm ml-1">CAD</span>
          </div>
          <ul class="space-y-3 text-sm text-dnd-text-muted mb-8 flex-1">
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>Full participation in the Operation Golden Sword D&D campaign</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>Choose your theater of war and fight alongside your company</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>One mystery dice set to keep</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>Entry into the raffle for custom terrain &amp; accessories</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>Certificate of completion</span>
            </li>
          </ul>
          <a
            href={PLAYER_PAYMENT_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary w-full text-center block"
          >
            Enlist as a Player — $20
          </a>
        </div>

        <!-- Spectator Ticket -->
        <div class="card border border-dnd-border flex flex-col">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-widest text-dnd-text-muted">Spectator</span>
          </div>
          <div class="mb-6">
            <span class="text-5xl font-display text-dnd-text">$10</span>
            <span class="text-dnd-text-muted text-sm ml-1">CAD</span>
          </div>
          <ul class="space-y-3 text-sm text-dnd-text-muted mb-8 flex-1">
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>Full spectator access to the Legendary D&D event</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>Watch multiple tables and follow the campaign as it unfolds</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>One mystery dice set to keep</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-dnd-primary mt-0.5">✦</span>
              <span>Certificate of participation</span>
            </li>
          </ul>
          <a
            href={SPECTATOR_PAYMENT_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary w-full text-center block"
          >
            Join as a Spectator — $10
          </a>
        </div>
      </div>

      <p class="text-dnd-text-muted text-xs text-center mt-8">
        After payment, complete your registration details via the
        <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener noreferrer" class="text-dnd-primary hover:underline">sign-up form</a>.
      </p>
    </div>
  </section>

  <!-- Company Rosters -->
  <section class="py-16 bg-dnd-bg-secondary">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10">
          <p class="section-title">Current Roster</p>
          <h2 class="text-2xl md:text-3xl font-display">
            <span class="gold-gradient">Company Assignments</span>
          </h2>
          <p class="text-dnd-text-muted mt-4 max-w-2xl mx-auto">
            Each theater fields one company of adventurers. Find your comrades and claim your spot.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Theater 1: Iron Wolves -->
          <div class="card border-l-4 border-theater-assault">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">⚔️</span>
              <div>
                <h3 class="font-display text-dnd-text">Iron Wolves</h3>
                <p class="text-theater-assault text-sm">Theater 1 — Juno Beach</p>
              </div>
            </div>
            <div class="space-y-2">
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-primary font-semibold">Dungeon Master</span>
                <span class="text-dnd-text-muted">○ Open</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 1</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 2</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 3</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 4</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 5</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="text-dnd-text-muted">Adventurer 6</span>
                <span class="text-dnd-text-muted">○ Open</span>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-dnd-border">
              <p class="text-dnd-text-muted text-xs">5/7 slots filled</p>
            </div>
          </div>

          <!-- Theater 2: Stone Breakers -->
          <div class="card border-l-4 border-theater-siege">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">☄️</span>
              <div>
                <h3 class="font-display text-dnd-text">Stone Breakers</h3>
                <p class="text-theater-siege text-sm">Theater 2 — Gold Beach</p>
              </div>
            </div>
            <div class="space-y-2">
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-primary font-semibold">Dungeon Master</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 1</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 2</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 3</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 4</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 5</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="text-dnd-text-muted">Adventurer 6</span>
                <span class="text-dnd-text-muted">○ Open</span>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-dnd-border">
              <p class="text-dnd-text-muted text-xs">6/7 slots filled</p>
            </div>
          </div>

          <!-- Theater 3: Bête noire -->
          <div class="card border-l-4 border-theater-portals">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🌀</span>
              <div>
                <h3 class="font-display text-dnd-text">Bête noire</h3>
                <p class="text-theater-portals text-sm">Theater 3 — Portals & Bridges</p>
              </div>
            </div>
            <div class="space-y-2">
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-primary font-semibold">Dungeon Master</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 1</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 2</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 3</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 4</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 5</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="text-dnd-text-muted">Adventurer 6</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-dnd-border">
              <p class="text-dnd-accent text-xs font-semibold">7/7 slots filled — FULL</p>
            </div>
          </div>

          <!-- Theater 4: Storm Riders -->
          <div class="card border-l-4 border-theater-air">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🐦‍🔥</span>
              <div>
                <h3 class="font-display text-dnd-text">Storm Riders</h3>
                <p class="text-theater-air text-sm">Theater 4 — Sky Control</p>
              </div>
            </div>
            <div class="space-y-2">
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-primary font-semibold">Dungeon Master</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 1</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 2</span>
                <span class="text-dnd-accent">✓ Taken</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 3</span>
                <span class="text-dnd-text-muted">○ Open</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 4</span>
                <span class="text-dnd-text-muted">○ Open</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-dnd-border/50">
                <span class="text-dnd-text-muted">Adventurer 5</span>
                <span class="text-dnd-text-muted">○ Open</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="text-dnd-text-muted">Adventurer 6</span>
                <span class="text-dnd-text-muted">○ Open</span>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-dnd-border">
              <p class="text-dnd-text-muted text-xs">3/7 slots filled</p>
            </div>
          </div>
        </div>

        <!-- Legend -->
        <div class="mt-8 text-center">
          <div class="inline-flex items-center gap-6 text-sm">
            <span class="flex items-center gap-2">
              <span class="text-dnd-accent">✓ Taken</span>
            </span>
            <span class="flex items-center gap-2">
              <span class="text-dnd-text-muted">○ Open</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl font-display mb-6">
          <span class="gold-gradient">What You'll Need</span>
        </h2>
        <ul class="text-dnd-text-muted space-y-3 text-left max-w-md mx-auto">
          <li class="flex items-start gap-3">
            <span class="text-dnd-primary">⚔️</span>
            <span>A level 7 character (or we can help you create one)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-dnd-primary">📜</span>
            <span>Your character sheet and dice</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-dnd-primary">🛡️</span>
            <span>A willingness to fight for Amn</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-dnd-primary">🍺</span>
            <span>Snacks and drinks to fuel the battle</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>
