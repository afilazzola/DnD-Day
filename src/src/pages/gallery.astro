---
import BaseLayout from '../layouts/BaseLayout.astro';

const images = [
  'IMG_2592', 'IMG_2593', 'IMG_2594', 'IMG_2595', 'IMG_2596', 'IMG_2597',
  'IMG_2598', 'IMG_2599', 'IMG_2600', 'IMG_2602', 'IMG_2603', 'IMG_2604',
  'IMG_2605', 'IMG_2606', 'IMG_2607', 'IMG_2609', 'IMG_2610', 'IMG_2611',
  'IMG_2612', 'IMG_2613', 'IMG_2615', 'IMG_2616', 'IMG_2619', 'IMG_2620',
  'IMG_2622', 'IMG_2623', 'IMG_2625', 'IMG_2626', 'IMG_2627', 'IMG_2628',
  'IMG_2629', 'IMG_2631',
];
---

<BaseLayout
  title="Event Gallery — Operation Golden Sword"
  description="Photos from Operation Golden Sword, the multi-table D&D event held on June 6th, 2026."
>
  <!-- Page Header -->
  <section class="py-16 bg-dnd-bg">
    <div class="container-custom text-center">
      <p class="section-title mb-4">Operation Golden Sword</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold mb-4">
        <span class="gold-gradient">Event Gallery</span>
      </h1>
      <p class="text-dnd-text-muted text-lg max-w-xl mx-auto">
        June 6th, 2026 — Relive the adventure through the eyes of those who were there.
      </p>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-12 bg-dnd-bg-secondary">
    <div class="container-custom">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {images.map((name, index) => (
          <button
            class="gallery-item group relative aspect-square overflow-hidden rounded-lg border border-dnd-border hover:border-dnd-primary/50 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-dnd-primary"
            data-index={index}
            aria-label={`View photo ${index + 1} of ${images.length}`}
          >
            <img
              src={`/gallery/${name}.jpg`}
              alt={`Event photo ${index + 1}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 group-hover:brightness-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-dnd-bg/0 group-hover:bg-dnd-bg/20 transition-colors duration-300 flex items-center justify-center">
              <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-80 transition-opacity duration-300 drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </div>
          </button>
        ))}
      </div>

      <p class="text-center text-dnd-text-muted text-sm mt-8">
        {images.length} photos from the event
      </p>
    </div>
  </section>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 bg-black/95 z-50 hidden items-center justify-center"
    role="dialog"
    aria-modal="true"
    aria-label="Photo lightbox"
  >
    <!-- Close button -->
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 text-dnd-text-muted hover:text-dnd-primary transition-colors p-2 rounded-lg hover:bg-white/10"
      aria-label="Close"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Prev button -->
    <button
      id="lightbox-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 text-dnd-text-muted hover:text-dnd-primary transition-colors p-2 rounded-lg hover:bg-white/10"
      aria-label="Previous photo"
    >
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Next button -->
    <button
      id="lightbox-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-dnd-text-muted hover:text-dnd-primary transition-colors p-2 rounded-lg hover:bg-white/10"
      aria-label="Next photo"
    >
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Image -->
    <div class="max-w-5xl max-h-[85vh] mx-16 flex flex-col items-center gap-3">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl"
      />
      <p id="lightbox-counter" class="text-dnd-text-muted text-sm font-display tracking-wider"></p>
    </div>
  </div>
</BaseLayout>

<script>
  const images = [
    'IMG_2592', 'IMG_2593', 'IMG_2594', 'IMG_2595', 'IMG_2596', 'IMG_2597',
    'IMG_2598', 'IMG_2599', 'IMG_2600', 'IMG_2602', 'IMG_2603', 'IMG_2604',
    'IMG_2605', 'IMG_2606', 'IMG_2607', 'IMG_2609', 'IMG_2610', 'IMG_2611',
    'IMG_2612', 'IMG_2613', 'IMG_2615', 'IMG_2616', 'IMG_2619', 'IMG_2620',
    'IMG_2622', 'IMG_2623', 'IMG_2625', 'IMG_2626', 'IMG_2627', 'IMG_2628',
    'IMG_2629', 'IMG_2631',
  ];

  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCounter = document.getElementById('lightbox-counter')!;
  let currentIndex = 0;

  function openLightbox(index: number) {
    currentIndex = index;
    updateLightbox();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function updateLightbox() {
    const name = images[currentIndex];
    lightboxImg.src = `/gallery/${name}.jpg`;
    lightboxImg.alt = `Event photo ${currentIndex + 1}`;
    lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
  }

  function navigate(delta: number) {
    currentIndex = (currentIndex + delta + images.length) % images.length;
    updateLightbox();
  }

  document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = parseInt(btn.dataset.index ?? '0', 10);
      openLightbox(index);
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => navigate(-1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => navigate(1));

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });
</script>
